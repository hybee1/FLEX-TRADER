name: CI - FLEX TRADER Main Branch

on:
  push:
    branches:
      - '**'      # any branch
  pull_request:
    branches:
      - main 

jobs:
  build:
    runs-on: ubuntu-latest
    
    strategy:
      matrix:
        service: [flex-trader-api-gateway-service, flex-trader-auth, flex-trader-reactive-websocket-server, flex-trader-websocket-server]  # list all services

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 23
        uses: actions/setup-java@v4
        with:
          java-version: '23'
          distribution: 'temurin'
          cache: maven

      - name: Clean previous build
        run: mvn -B clean

      - name: Run tests
        run: mvn -B test --file pom.xml

      - name: Build and package with Maven
        run: mvn -B package --file pom.xml
